rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // Reusable global helpers
    function isSignedIn() {
      return request.auth != null;
    }

    // 1. Validate RatingEntry Shape
    function isValidRatingEntry(data) {
      return data.id is string && data.id.size() <= 128
        && data.type is string
        && data.name is string && data.name.size() > 0 && data.name.size() <= 200;
    }

    // 2. Validate UserProfile Shape
    function isValidUserProfile(data) {
      return data.uid is string && data.uid == request.auth.uid
        && data.displayName is string && data.displayName.size() <= 100;
    }

    // 3. Validate ContributionLog Shape
    function isValidContributionLog(data) {
      return data.userId is string && data.userId == request.auth.uid
        && data.userName is string && data.userName.size() <= 100;
    }

    // --- Core Catalog Entries ---
    match /entries/{entryId} {
      allow read: if true; // Public catalog viewable by anyone
      allow write: if isSignedIn() && isValidRatingEntry(request.resource.data);
    }

    // --- Contributor Profiles ---
    match /users/{userId} {
      allow read: if true; // Publicly viewable stats/profiles
      allow write: if isSignedIn() && userId == request.auth.uid && isValidUserProfile(request.resource.data);
    }

    // --- Immutable Activity Contribution Logs ---
    match /contributions/{contributionId} {
      allow read: if true; // Public activity feed
      allow create: if isSignedIn() && isValidContributionLog(request.resource.data);
      allow update, delete: if false; // Append-only historical entries
    }
  }
}
