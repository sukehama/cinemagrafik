rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // Reusable global helpers
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isAdmin() {
      return isSignedIn() && request.auth.token.email == 'rogerstold@gmail.com';
    }
    
    function isModerator() {
      return isSignedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'moderator';
    }
    
    function isAdminOrModerator() {
      return isAdmin() || isModerator();
    }

    // 1. Validate RatingEntry Shape
    function isValidRatingEntry(data) {
      return data.id is string && data.id.size() <= 128
        && data.type is string
        && data.name is string && data.name.size() > 0 && data.name.size() <= 200;
    }

    // 2. Validate UserProfile Shape
    function isValidUserProfile(data) {
      return data.uid is string && data.uid == request.auth.uid
        && data.displayName is string && data.displayName.size() <= 100;
    }

    // 3. Validate ContributionLog Shape
    function isValidContributionLog(data) {
      return data.userId is string && data.userId == request.auth.uid
        && data.userName is string && data.userName.size() <= 100;
    }

    // --- Core Catalog Entries ---
    // Anyone can read the catalog. Only admins/moderators can write directly.
    // Regular users submit via pending_submissions for admin review.
    match /entries/{entryId} {
      allow read: if true;
      allow create, update, delete: if isAdminOrModerator() && isValidRatingEntry(request.resource.data);
    }

    // --- Contributor Profiles ---
    match /users/{userId} {
      allow read: if true; // Publicly viewable stats/profiles
      // Users can write their own profile, but only admin can change role
      allow write: if isSignedIn() && userId == request.auth.uid
        && isValidUserProfile(request.resource.data)
        && (request.resource.data.role is string
            ? (request.resource.data.role == getResource().data.role || isAdmin())
            : true);
      // Admin can update any user (e.g. assign moderator role)
      allow update: if isAdmin();
    }

    // --- Immutable Activity Contribution Logs ---
    match /contributions/{contributionId} {
      allow read: if true; // Public activity feed
      allow create: if isSignedIn() && isValidContributionLog(request.resource.data);
      allow update, delete: if false; // Append-only historical entries
    }

    // --- Pending Submissions ---
    // Authenticated users can submit. Only admin can read/approve/reject.
    match /pending_submissions/{submissionId} {
      allow read: if isAdmin();
      allow create: if isSignedIn();
      allow update, delete: if isAdmin();
    }
  }
}
