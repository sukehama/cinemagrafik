rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Global Safety Net (Rule 1)
    match /{document=**} {
      allow read, write: if false;
    }

    // Reusable, hardened global helpers (Phase 3)
    function isSignedIn() {
      return request.auth != null;
    }

    function isEmailVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // 1. Validate RatingEntry Shape (The "Anti-Update-Gap")
    function isValidRatingEntry(data) {
      return data.id is string && data.id.size() <= 128
        && data.type is string && (data.type == 'show' || data.type == 'movie' || data.type == 'universe')
        && data.name is string && data.name.size() > 0 && data.name.size() <= 200
        && data.year is string && data.year.size() <= 50;
    }

    // 2. Validate UserProfile Shape
    function isValidUserProfile(data) {
      return data.uid is string && data.uid == request.auth.uid
        && data.displayName is string && data.displayName.size() <= 100
        && data.email is string && data.email.size() <= 100;
    }

    // 3. Validate ContributionLog Shape
    function isValidContributionLog(data) {
      return data.userId is string && data.userId == request.auth.uid
        && data.userName is string && data.userName.size() <= 100
        && data.actionType is string && (data.actionType == 'add' || data.actionType == 'edit' || data.actionType == 'delete' || data.actionType == 'rating' || data.actionType == 'review')
        && data.entryName is string && data.entryName.size() <= 200;
    }

    // --- Core Catalog Entries ---
    match /entries/{entryId} {
      allow read: if true; // Public catalog viewable by anyone
      allow write: if isEmailVerified() && isValidRatingEntry(request.resource.data);
    }

    // --- Contributor Profiles ---
    match /users/{userId} {
      allow read: if true; // Publicly viewable stats/profiles
      allow write: if isEmailVerified() && userId == request.auth.uid && isValidUserProfile(request.resource.data);
    }

    // --- Immutable Activity Contribution Logs ---
    match /contributions/{contributionId} {
      allow read: if true; // Public activity feed
      allow create: if isEmailVerified() && isValidContributionLog(request.resource.data);
      allow update, delete: if false; // Append-only historical entries
    }
  }
}
